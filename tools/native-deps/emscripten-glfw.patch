+// gl_backend.h - the ikvm build's GL seam: mesa-wink, Mesa's own OpenGL on WebGPU.
+//
+// Every GL call runs in wasm (st/mesa -> the gex_wgpu Gallium driver) and reaches the browser only as batched WebGPU
+// work, where the earlier backends paid a WebGL call -- validation, typed-array views, V8<->Blink binding -- per GL call.
+// NG-GL4ES/Krypton (WebGL) and MobileGL (WebGPU) are gone; wink_emscripten_compat.h is the seam mesa-wink ships for
+// exactly this file. Build mesa-wink with `wink/build.sh --variant=mt`; build-glfw.sh passes its include directory.
+//
+// Contexts get the highest COMPATIBILITY-profile version the device allows (wink_set_next_context's default): Minecraft
+// asks GLFW for 2.0 with any profile and uses fixed-function GL.
+#ifndef EMSCRIPTEN_GLFW3_GL_BACKEND_H
+#define EMSCRIPTEN_GLFW3_GL_BACKEND_H
+
+#include <stdint.h>
+#include <emscripten/html5.h>
+#include <emscripten/html5_webgl.h>
+#include "wink_emscripten_compat.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// --- The seam the patched emscripten-glfw calls (glfw3.cpp implements these on wink_*) ---------------------------
+EMSCRIPTEN_WEBGL_CONTEXT_HANDLE gl_backend_webgl_create_context(const char *target, const EmscriptenWebGLContextAttributes *attributes);
+EMSCRIPTEN_RESULT               gl_backend_webgl_make_context_current(EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context);
+EMSCRIPTEN_RESULT               gl_backend_webgl_destroy_context(EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context);
+void*                           gl_backend_get_proc_address(const char *name);
+void                            gl_backend_resize(int width, int height);
+// Present the current context's surface.
+void                            gl_backend_present(void);
+// WINK_GL_MAIN: GL runs on the main thread, which presents and paces the swap, so swapBuffers must not yield for it.
+int                             gl_backend_on_main(void);
+// The swap interval wink's main-thread pacing uses (GLFW's: 0 unpaced, N frames).
+void                            gl_backend_present_interval(int interval);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // EMSCRIPTEN_GLFW3_GL_BACKEND_H
